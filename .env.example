# ---------- Shared / API ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://silwasa:silwasa_dev_password@localhost:5432/silwasa_cms?schema=public
DIRECT_DATABASE_URL=postgresql://silwasa:silwasa_dev_password@localhost:5432/silwasa_cms?schema=public

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# 32 bytes as 64 hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional cookie settings (defaults are fine for local development)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_DOMAIN=

# ---------- First Super Admin (used only by `pnpm db:seed`) ----------
# Set these for the first seed, then REMOVE the password from your environment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# ---------- Media (Phase 4) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (Phase 9) ----------
BREVO_API_KEY=
SENDGRID_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ---------- Web (apps/web/.env.local) ----------
