{
  "name": "silwasa-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @silwasa/api --filter @silwasa/web dev",
    "dev:api": "pnpm --filter @silwasa/api dev",
    "dev:web": "pnpm --filter @silwasa/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @silwasa/api prisma:generate",
    "db:migrate": "pnpm --filter @silwasa/api prisma:migrate",
    "db:seed": "pnpm --filter @silwasa/api prisma:seed",
    "test:api": "pnpm --filter @silwasa/api test",
    "test:web": "pnpm --filter @silwasa/web test",
    "test:api:watch": "pnpm --filter @silwasa/api exec vitest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "typescript": "~5.9.3"
    }
  }
}
